import("//build_overrides/build.gni")
import("${build_root}/config/linux/pkg_config.gni")

pkg_config("sqlite_config") {
    packages = [ "sqlite3" ]
}

source_set("sqlite") {
    sources = [
        "Connection.cpp",
        "Statement.cpp",
    ]

    public = [
        "Connection.h",
        "Statement.h",
    ]

    public_deps = [ "//third_party/tl_expected" ]

    configs += [ ":sqlite_config" ]
}

source_set("migrator") {
    sources = [ "Migrator.cpp" ]

    public = [ "Migrator.h" ]

    deps = [
        ":sqlite",
        "//src/common/logging",
        "//third_party/tl_expected"
    ]

    configs += [ "//:app_includes" ]
}
